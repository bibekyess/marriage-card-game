# Copy to .env to override defaults used by docker-compose.yml.
# Host port the app is published on, on 127.0.0.1 only (container always listens on 3000).
APP_PORT=9062
# NOTE: POSTGRES_PASSWORD goes into a URL, so it must be URL-safe (no @ : / # ? or spaces).
# Postgres credentials/database (also used to build the app's DATABASE_URL).
# POSTGRES_PASSWORD is required; pick a strong one.
POSTGRES_USER=marriage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marriage

# Set to 1 when the app runs behind a reverse proxy (Caddy, nginx, a cloud load balancer)
# so rate limits use the real client address from X-Forwarded-For.
TRUST_PROXY=

# Admin page at /admin (HTTP Basic: any username, this as the password). Leave empty to disable.
# Needs at least 16 characters or the page stays off; generate one with `openssl rand -hex 32`.
# It also salts the stored visitor-address hashes: they stay pseudonymous (no raw addresses are kept),
# and changing the token resets the unique-visitor counts because everyone hashes differently.
ADMIN_TOKEN=

# Visitor stats with Umami (optional): docker compose --profile stats up -d
# Set a long random UMAMI_APP_SECRET (e.g. `openssl rand -hex 32`) and a URL-safe UMAMI_DB_PASSWORD.
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
# Host port for the Umami dashboard, on 127.0.0.1 only.
UMAMI_PORT=9063
# Point the app at Umami and fill in the website id after creating it in the dashboard.
# UMAMI_URL=http://umami:3000
# UMAMI_WEBSITE_ID=
# Optional link shown on /admin.
# UMAMI_DASHBOARD_URL=
