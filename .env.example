# Copy to .env to override defaults used by docker-compose.yml.
# Host port the app is published on (container always listens on 3000).
APP_PORT=9062
# NOTE: POSTGRES_PASSWORD goes into a URL, so it must be URL-safe (no @ : / # ? or spaces).
# Postgres credentials/database (also used to build the app's DATABASE_URL).
# POSTGRES_PASSWORD is required; pick a strong one.
POSTGRES_USER=marriage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marriage

# Set to 1 when the app runs behind a reverse proxy (Caddy, nginx, a cloud load balancer)
# so rate limits use the real client address from X-Forwarded-For.
TRUST_PROXY=
